# ============================================
# Variables de entorno del Backend
# Copia este archivo como `.env` y ajusta los
# valores según tu entorno local.
# ============================================

# Puerto donde correrá el servidor Express
PORT=4000

# URL de conexión a la base de datos MongoDB local
MONGO_URI=mongodb://127.0.0.1:27017/cuenta_bancaria

# Origen permitido para peticiones CORS del frontend (Vite)
CLIENT_URL=http://localhost:5173
